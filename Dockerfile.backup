# The daily backup job (Railway cron service "nc-backup"; docs/BACKUP_RUNBOOK.md). Node + the PostgreSQL 18 client tools (pg_dump /
# pg_restore must match the server's major version) and only what the job needs: no native build tools, no app code.
# Railway: set RAILWAY_DOCKERFILE_PATH=Dockerfile.backup on the service; start command `node scripts/backup-job.js`.
FROM node:22-bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends ca-certificates curl gnupg \
    && install -d /usr/share/postgresql-common/pgdg \
    && curl -fsSL -o /usr/share/postgresql-common/pgdg/apt.postgresql.org.asc https://www.postgresql.org/media/keys/ACCC4CF8.asc \
    && echo "deb [signed-by=/usr/share/postgresql-common/pgdg/apt.postgresql.org.asc] https://apt.postgresql.org/pub/repos/apt bookworm-pgdg main" > /etc/apt/sources.list.d/pgdg.list \
    && apt-get update \
    && apt-get install -y --no-install-recommends postgresql-client-18 \
    && apt-get purge -y curl gnupg && apt-get autoremove -y \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /app
COPY package*.json ./
# --ignore-scripts: better-sqlite3 / sharp are the app's, not the job's; their native builds are skipped (the job never loads them)
RUN npm ci --omit=dev --ignore-scripts
COPY src ./src
COPY scripts ./scripts
USER node
CMD ["node", "scripts/backup-job.js"]
