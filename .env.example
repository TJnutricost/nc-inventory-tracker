# ---- Nutricost IT Assets configuration ----
# Copy this file to .env and fill it in, then restart the app.

# Public address people use to reach the app (used in email links). Use https:// in production —
# phone cameras only work for barcode scanning over https.
APP_URL=https://it.nutricost.com
PORT=3000

# Long random string used to sign login cookies (generate with: openssl rand -hex 32)
SESSION_SECRET=

# ---- Google sign-in (src/googleAuth.js; README "Google sign-in") ----
# Off unless BOTH are set. From Google Cloud Console > (your project) > Clients > a "Web application" client whose redirect URI is
# APP_URL + /auth/google/callback. Secrets live only here or in Railway secrets.
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# The only Google Workspace domain let in (default nutricost.com):
# GOOGLE_HOSTED_DOMAIN=nutricost.com
# Comma-separated addresses made admins when they sign in with Google (the first admin of a new environment; IT does the rest in People):
# GOOGLE_ADMIN_EMAILS=
# (An address listed here is made admin at EVERY Google sign-in, so demoting it in People does not stick while it is listed:
# clear the variable once the first admins exist.)

# ---- First-run setup (POST /api/setup: whoever completes it on an empty database becomes the first admin) ----
# Local development: open. In production (NODE_ENV=production, as in the Docker image) it is CLOSED unless this is set; the first
# admin then comes from Google sign-in with GOOGLE_ADMIN_EMAILS, or set a one-time code here, enter it in the setup form, and remove it.
# SETUP_TOKEN=

# ---- Email via Google Workspace / Gmail (src/mailer.js) ----
# These are ALL the variables the mailer reads. Passwords and keys live ONLY here (or in Railway secrets), never in the database
# or the Settings screen. Email is "configured" only when BOTH SMTP_USER and SMTP_PASS are set; otherwise nothing is sent and
# every message is just recorded in Settings > Outbox.
#   SMTP_HOST   default smtp.gmail.com
#   SMTP_PORT   default 465 (implicit TLS). Any other port (e.g. 587) uses STARTTLS.
#   SMTP_USER   the mailbox that signs in
#   SMTP_PASS   its Google App Password (16 characters; Google Account > Security > 2-Step Verification must be on, then
#               "App passwords"). A normal account password will NOT work. If App passwords are missing, a Workspace admin
#               has to allow them (Admin console > Security). The mailer only supports sign-in with a user + password.
#   MAIL_FROM   the sender address, e.g. "Nutricost IT <it@nutricost.com>". Optional: defaults to SMTP_USER. Gmail only sends
#               From the signed-in mailbox or one of its verified "Send mail as" aliases.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=it@nutricost.com
SMTP_PASS=
MAIL_FROM="Nutricost IT <it@nutricost.com>"
# The IT display name and IT contact / reply-to address are set in the app (Settings > IT email), not here.
# Mail is always sent From the verified sender above, with the IT contact as Reply-To. Only if the provider allows the
# IT contact address as a sender (e.g. a Gmail "Send mail as" alias) may you set this to send FROM that address:
# MAIL_ALLOW_IT_FROM=1
# Time zone used for times in emails, such as a waitlist hold deadline (IANA name; default: the server's zone)
# APP_TIMEZONE=America/Denver
#
# LOCAL TESTING WITH REAL EMAIL: the seeded people use @example.com addresses, so no one would receive anything. Put your own
# SMTP_USER / SMTP_PASS above and set this to your real work address: EVERY outgoing email is then delivered to that one address
# instead of its real recipient, with the intended recipient shown in the subject ("[DEV for gray.garcia@example.com] ...") and in
# a banner at the top of the message. Nothing else changes. Leave it UNSET in production. (An invalid value sends nothing at all.)
# MAIL_TEST_RECIPIENT=you@nutricost.com
# (A Workspace SMTP relay that needs no password is NOT supported by the current mailer: it always signs in with SMTP_USER/SMTP_PASS.)

# Where the database and photos are stored (back this folder up!)
# DATA_DIR=./data

# Local PostgreSQL (preparation only): the app does NOT use DATABASE_URL yet and still runs on SQLite (see README, "Local PostgreSQL").
# Only scripts/db-check.js reads it, and it refuses any host other than localhost, 127.0.0.1 or ::1. Never put a Railway URL here.
# DATABASE_URL=postgresql://nc_dev:nc_dev@127.0.0.1:5433/nc_assets_dev
