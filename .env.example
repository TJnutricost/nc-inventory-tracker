# ---- Nutricost IT Assets configuration ----
# Copy this file to .env and fill it in, then restart the app.

# Public address people use to reach the app (used in email links). Use https:// in production —
# phone cameras only work for barcode scanning over https.
APP_URL=https://assets.nutricost.com
PORT=3000

# Long random string used to sign login cookies (generate with: openssl rand -hex 32)
SESSION_SECRET=

# ---- Email via Google Workspace / Gmail ----
# Option A (simplest): a Workspace mailbox such as it@nutricost.com with 2-Step Verification on,
# plus an App Password (Google Account → Security → App passwords).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=465
SMTP_USER=it@nutricost.com
SMTP_PASS=
MAIL_FROM="Nutricost IT <it@nutricost.com>"
# Option B: Workspace SMTP relay — set SMTP_HOST=smtp-relay.gmail.com, SMTP_PORT=587,
# and configure the relay in Admin console → Apps → Google Workspace → Gmail → Routing.

# Where the database and photos are stored (back this folder up!)
# DATA_DIR=./data
